#!/usr/bin/env node
'use strict';
// Adapters are explicit modules. The bundled Claude registry adapter is
// read-only and does not claim that launch or validation is implemented.
const fs=require('node:fs');
const path=require('node:path');
const {Controller}=require('../lib/controller.cjs');
const usage='Usage: node session-batch --state-root <absolute-dir> [--adapter <absolute-module>] '+
  '<create input.json|start run issue|plan run issue plan.json|approve run issue approval.json|build run issue|review run issue|queue run|tick run|show run>';
const args=process.argv.slice(2);
async function main() {
  if(args.length===1 && args[0]==='--help') {console.log(usage);return;}
  if(args.shift()!=='--state-root') throw Error(usage);
  const root=args.shift();if(!root || !path.isAbsolute(root)) throw Error('absolute --state-root required');
  let adapter={};
  if(args[0]==='--adapter') {
    args.shift();const modulePath=args.shift();
    if(!modulePath || !path.isAbsolute(modulePath)) throw Error('absolute adapter module required');
    const loaded=require(modulePath);adapter=typeof loaded.createAdapter==='function' ? await loaded.createAdapter() : loaded;
  }
  const command=args.shift();
  const lengths={create:1,start:2,plan:3,approve:3,build:2,review:2,queue:1,tick:1,show:1};
  if(!Object.hasOwn(lengths,command) || args.length!==lengths[command]) throw Error(usage);
  if(command==='show') {
    if(!/^[a-zA-Z0-9_-]{1,100}$/.test(args[0])) throw Error('invalid run ID');
    console.log(JSON.stringify(JSON.parse(fs.readFileSync(path.join(root,'runs',args[0]+'.json'),'utf8')),null,2));return;
  }
  const controller=new Controller(root,adapter);
  const json=file=>JSON.parse(fs.readFileSync(file,'utf8'));
  let result;
  if(command==='create') {
    const input=json(args[0]);
    if(!Number.isSafeInteger(input.policy?.operation_timeout_ms) || input.policy.operation_timeout_ms<100 || input.policy.operation_timeout_ms>300000)
      throw Error('operation_timeout_ms must be 100..300000');
    result=await controller.deadline(input.run_id,input.policy?.operation_timeout_ms,Promise.resolve().then(()=>controller.create(input)));
  }
  if(command==='start') result=await controller.boundedOperation(args[0],args[1],()=>controller.start(args[0],args[1]));
  if(command==='plan') result=await controller.boundedOperation(args[0],args[1],()=>controller.plan(args[0],args[1],json(args[2])));
  if(command==='approve') result=await controller.boundedOperation(args[0],args[1],()=>controller.approvePlan(args[0],args[1],json(args[2])));
  if(command==='build') result=await controller.boundedOperation(args[0],args[1],()=>controller.beginBuild(args[0],args[1]));
  if(command==='review') result=await controller.boundedOperation(args[0],args[1],()=>controller.review(args[0],args[1]));
  if(command==='queue') result=await controller.boundedOperation(args[0],null,()=>controller.reviewQueue(args[0]));
  if(command==='tick') result=await controller.tick(args[0]);
  console.log(JSON.stringify(result,null,2));
}
main().catch(e=>{console.error(e.message);process.exitCode=2;});
