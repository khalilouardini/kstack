#!/usr/bin/env python3
"""Audit candidate eligibility separately from project coverage; no network or writes."""
import argparse
import copy
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import runpy
import sys

COVERAGE = runpy.run_path(str(Path(__file__).with_name('graph-coverage')))
GRAPH = COVERAGE['API']
MAX_REPAIRS = 3


def digest(value):
    return 'sha256:' + hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def required_text(value, label):
    if not isinstance(value, str) or not value.strip() or value.strip().startswith('TODO:'):
        raise ValueError(f'{label}: complete cited evidence required')
    return value


def utc(value):
    required_text(value, 'checked_at')
    if not value.endswith('Z'):
        raise ValueError('checked_at must be UTC')
    return datetime.fromisoformat(value[:-1] + '+00:00')


def reconcile(base, proposed, repairs, selected):
    """Only append small, edge-free maintenance units; never mutate approved policy."""
    GRAPH['validate'](proposed)
    before = {n['id']: n for n in base['nodes']}
    after = {n['id']: n for n in proposed['nodes']}
    if any(proposed[k] != v for k, v in base.items() if k != 'nodes'):
        raise ValueError('REVIEWED_PUBLICATION_REQUIRED: scope, dependencies, release criteria or policy changed')
    if any(after.get(key) != value for key, value in before.items()):
        raise ValueError('REVIEWED_PUBLICATION_REQUIRED: existing nodes, acceptance or human gates changed')
    added = [n for n in proposed['nodes'] if n['id'] not in before]
    if not 1 <= len(added) <= MAX_REPAIRS or len(repairs) != len(added):
        raise ValueError('local reconciliation permits one to three selected maintenance units')
    by_id = {r['node_id']: r for r in repairs}
    if len(by_id) != len(repairs) or set(by_id) != {n['id'] for n in added}:
        raise ValueError('exact repair evidence required for every added node')
    origins = {}
    for node in added:
        repair = by_id[node['id']]
        origin = before.get(repair.get('origin'))
        if repair.get('kind') != 'maintenance' or not origin or origin['kind'] != 'unit':
            raise ValueError('REVIEWED_PUBLICATION_REQUIRED: repair must trace an existing approved unit')
        required_text(repair.get('rationale'), 'repair rationale within existing scope')
        if node['kind'] != 'unit' or node['issue_ref'] not in selected or any(
                node[k] != origin[k] for k in ('project', 'unit_of', 'owner', 'effort')):
            raise ValueError('REVIEWED_PUBLICATION_REQUIRED: repair expands ownership or approved boundary')
        # New prerequisites also require review. No copied, removed or relaxed edges.
        origins[node['id']] = origin['id']
    return added, origins


def live_reconcile(base, snapshot, request):
    """Build an append-only, candidate-scoped projection from cited live facts.

    This does not authenticate the collector's Linear reads, decisions or scope
    interpretation. The caller must verify those independently. Existing graph
    policy, nodes and edges remain intact; native blockers only add conditions.
    """
    entries = request.get('live_units', [])
    if not isinstance(entries, list) or len(entries) > 1000 or (not entries and request.get('live_relations') is not True):
        raise ValueError('live reconciliation requires unit or relation evidence')
    if request.get('repairs'):
        raise ValueError('live units and a maintenance reconciliation cannot be mixed')
    graph = copy.deepcopy(base)
    working = copy.deepcopy(snapshot)
    enriched = copy.deepcopy(request)
    issue_entries = {i['id']: (p, i) for p in working['projects'] for i in p['issues']}
    by_id = {}
    new_nodes = []
    new_projects = []
    added_edges = []
    before_nodes = {n['id']: n for n in base['nodes']}
    before_refs = {n['issue_ref'] for n in base['nodes'] if n['kind'] == 'unit'}
    for entry in entries:
        iid = entry.get('issue_id')
        if not isinstance(iid, str) or not COVERAGE['UUID'].fullmatch(iid) or iid in by_id or iid in before_refs:
            raise ValueError('live unit must identify one unique unmapped issue')
        if iid not in issue_entries:
            raise ValueError('complete live project membership required for live unit')
        project, issue = issue_entries[iid]
        if entry.get('scope_confirmed') is not True or entry.get('scope_dependencies_complete') is not True:
            raise ValueError('live unit needs verified in-scope and complete scope-dependency evidence')
        scope = entry.get('scope', {})
        COVERAGE['safe_path'](scope.get('path'))
        required_text(scope.get('quote'), 'approved scope quote')
        required_text(scope.get('rationale'), 'scope applicability rationale')
        if type(scope.get('line')) is not int or scope['line'] < 1:
            raise ValueError('approved scope line must be a positive integer')
        authority = required_text(entry.get('authorization_source'), 'original scope authorization source')
        if authority != f"{scope['path']}:{scope['line']}" and not re.match(r'^https://[^/\s]+/\S+', authority):
            raise ValueError('scope authorization source needs the exact cited file line or original HTTPS decision')
        for field in ('description', 'url', 'updated_at'):
            required_text(issue.get(field), 'live issue ' + field)
        if issue.get('relations_complete') is not True or issue.get('acceptance_complete') is not True:
            raise ValueError('live issue requires complete relations and acceptance evidence')
        acceptance = issue.get('acceptance')
        if not isinstance(acceptance, list) or not acceptance or any(
                not isinstance(a, str) or not a.strip() or a not in issue['description'] for a in acceptance):
            raise ValueError('live acceptance must quote complete issue criteria exactly')
        project_id = project['project_id']
        matches = [p for p in graph['projects'] if p['linear_id'] == project_id]
        if len(matches) > 1:
            raise ValueError('ambiguous project mapping')
        if matches:
            mapped = matches[0]
        else:
            mapped = {'key': 'livep_' + project_id.replace('-', '_'), 'title': project['project_name'],
                      'linear_id': project_id, 'scope_source': 'Per-unit approved scope evidence for ' + project_id,
                      'authorization': 'recorded'}
            graph['projects'].append(mapped)
            new_projects.append(mapped)
        if mapped['authorization'] != 'recorded':
            raise ValueError('REVIEWED_PUBLICATION_REQUIRED: scope authorization is draft')
        node = {'id': 'live_' + iid.replace('-', '_'), 'title': issue['identifier'], 'kind': 'unit',
                'project': mapped['key'], 'unit_of': None, 'issue_ref': iid, 'owner': 'implementer',
                'acceptance': copy.deepcopy(acceptance), 'source': issue['url'], 'effort': None}
        if node['id'] in before_nodes:
            raise ValueError('live unit identifier collides with existing graph')
        graph['nodes'].append(node)
        new_nodes.append(node)
        by_id[iid] = (entry, node)

    # Explicit scoped edges may point either way, including a future merge/review
    # gate. Every edge must touch its new unit and quote the source verbatim.
    for iid, (entry, node) in by_id.items():
        rows = entry.get('scope_edges')
        if not isinstance(rows, list):
            raise ValueError('live unit needs an explicit complete scope_edges list')
        issue = issue_entries[iid][1]
        for row in rows:
            edge = copy.deepcopy(row.get('edge'))
            evidence = row.get('evidence', {})
            if not isinstance(edge, dict) or node['id'] not in (edge.get('from'), edge.get('to')):
                raise ValueError('live scope edge must touch its evidenced unit')
            quote = required_text(evidence.get('quote'), 'scope edge source quote')
            kind = evidence.get('kind')
            expected = issue['url'] if kind == 'issue' else entry['scope']['path'] if kind == 'scope' else None
            body = issue['description'] if kind == 'issue' else entry['scope']['quote'] if kind == 'scope' else ''
            if edge.get('source') != expected or quote not in body:
                raise ValueError('live scope edge must quote its actual issue or approved scope source')
            graph['edges'].append(edge)
            added_edges.append(edge)

    selected = request['selected']
    nodes = {n['id']: n for n in graph['nodes']}
    units = {n['issue_ref']: n for n in graph['nodes'] if n['kind'] == 'unit' and n['issue_ref']}
    refs = {}
    for node in graph['nodes']:
        if node['issue_ref'] and node['kind'] in ('unit', 'external', 'human', 'evidence', 'release'):
            refs.setdefault(node['issue_ref'], []).append(node)
    if any(i not in units for i in selected):
        raise ValueError('UNMAPPED: selected work needs verified live unit evidence')
    # Read complete native blockers for the selected closure, including ancestors
    # discovered while adding blocker edges. Unknown blockers never disappear.
    examined = set()
    while True:
        roots = {(units[i]['id'], e) for i in selected for e in ('plan', 'build', 'merge')}
        closure = closure_nodes(nodes, ancestors(graph, roots))
        outstanding = {nodes[k]['issue_ref'] for k in closure if nodes[k]['issue_ref']} - examined
        if not outstanding:
            break
        for iid in sorted(outstanding):
            examined.add(iid)
            if iid not in issue_entries:
                raise ValueError('complete live issue evidence required throughout closure')
            issue = issue_entries[iid][1]
            blockers = issue.get('blocked_by')
            if issue.get('relations_complete') is not True or not isinstance(blockers, list) or any(
                    not isinstance(x, str) or not COVERAGE['UUID'].fullmatch(x) for x in blockers) or len(set(blockers)) != len(blockers):
                raise ValueError('complete canonical native blocker evidence required throughout live closure')
            for blocker in blockers:
                options = refs.get(blocker, [])
                source = units.get(blocker) or (options[0] if len(options) == 1 else None)
                if source is None:
                    raise ValueError('UNMAPPED: native blocker requires verified graph or live unit evidence')
                target = units.get(iid)
                if not target:
                    raise ValueError('native blockers require an executable target unit')
                event = {'unit': 'merge', 'external': 'complete', 'human': 'approve',
                         'evidence': 'pass', 'release': 'release'}[source['kind']]
                kind = {'human': 'human_decision', 'evidence': 'evidence_required'}.get(source['kind'], 'start_after')
                edge = {'from': source['id'], 'from_event': event, 'to': target['id'],
                        'to_event': 'plan', 'type': kind, 'source': issue['url']}
                signature = lambda e: (e['from'], e['from_event'], e['to'], e['to_event'], e['type'])
                if not any(signature(e) == signature(edge) for e in graph['edges']):
                    graph['edges'].append(edge)
                    added_edges.append(edge)
    if any(node['id'] not in closure for _, node in by_id.values()):
        raise ValueError('live units must belong to the selected dependency closure')
    GRAPH['validate'](graph)

    # Existing cited evidence must exactly match the immutable base; add only
    # deterministic, separately retained live edges. Never erase old gates.
    proofs = {p['node_id']: p for p in enriched.get('nodes', [])}
    if len(proofs) != len(enriched.get('nodes', [])):
        raise ValueError('duplicate closure evidence')
    for key in closure:
        node = nodes[key]
        incoming_before = [e for e in base['edges'] if e['to'] == key]
        if key in before_nodes and key in proofs:
            if proofs[key].get('prerequisites') != incoming_before:
                raise ValueError('base prerequisite evidence must match the published graph')
            proofs[key]['prerequisites'] += [e for e in added_edges if e['to'] == key]
    for iid, (entry, node) in by_id.items():
        if node['id'] in proofs:
            raise ValueError('live unit proof is derived from its cited live evidence')
        proof = {'node_id': node['id'], 'owner': node['owner'], 'acceptance': node['acceptance'],
                 'source': issue_entries[iid][1]['url'], 'scope': copy.deepcopy(entry['scope']),
                 'prerequisites': [e for e in graph['edges'] if e['to'] == node['id']]}
        enriched.setdefault('nodes', []).append(proof)
    for iid in examined:
        issue = issue_entries[iid][1]
        mapped_keys = {n['id'] for n in graph['nodes'] if n['issue_ref'] == iid}
        before = [e for e in base['edges'] if e['to'] in mapped_keys]
        if iid in before_refs or any(n['issue_ref'] == iid for n in base['nodes']):
            if issue.get('prerequisites') != before:
                raise ValueError('base issue prerequisites must match the published graph')
        elif issue.get('prerequisites') not in (None, []):
            raise ValueError('unmapped issue cannot claim published graph prerequisites')
        issue['prerequisites'] = [e for e in graph['edges'] if e['to'] in mapped_keys]
    return graph, working, enriched, new_projects, new_nodes, added_edges


def ancestors(graph, roots):
    incoming = {}
    for edge in graph['edges']:
        incoming.setdefault((edge['to'], edge['to_event']), set()).add((edge['from'], edge['from_event']))
    for node in graph['nodes']:
        if node['kind'] == 'unit':
            incoming.setdefault((node['id'], 'build'), set()).add((node['id'], 'plan'))
            incoming.setdefault((node['id'], 'merge'), set()).add((node['id'], 'build'))
    found, pending = set(), list(roots)
    while pending:
        event = pending.pop()
        if event in found:
            continue
        found.add(event)
        pending.extend(incoming.get(event, set()))
    return found


def approval_body(body):
    """Exclude explicitly non-authoritative progress lines, never requirements."""
    facts = []
    fenced = None
    progress = re.compile(
        r'<!-- kstack-progress: (?:PLANNED|BUILDING|PR_OPEN|REVIEWING|STOPPED|COMPLETE) -->')
    skip_note_blanks = False
    for line in body.splitlines():
        if skip_note_blanks and not line.strip():
            continue
        skip_note_blanks = False
        marker = re.match(r'^\s*(`{3,}|~{3,})(.*)$', line)
        if marker:
            token, tail = marker.groups()
            if fenced is None:
                fenced = (token[0], len(token))
            elif token[0] == fenced[0] and len(token) >= fenced[1] and not tail.strip():
                fenced = None
            facts.append(line)
            continue
        if fenced is None and progress.fullmatch(line):
            # Keep one existing paragraph separator, rather than the empty
            # paragraph left behind by an excluded metadata line.
            skip_note_blanks = not facts or not facts[-1].strip()
            continue
        facts.append(line)
    while facts and not facts[-1].strip() and fenced is None:
        facts.pop()
    return '\n'.join(facts)


def semantic_edges(edges):
    return sorted(({k: v for k, v in edge.items() if k != 'source'} for edge in edges),
                  key=lambda edge: json.dumps(edge, sort_keys=True))


def closure_graph(graph, events, closure, semantic=False):
    """Protect this unit's conditions, including future merge gates, not siblings."""
    projects = {n['project'] for n in graph['nodes'] if n['id'] in closure}
    return {'schema_version': graph['schema_version'], 'policy': graph['policy'],
            'projects': sorted(({k: v for k, v in p.items() if k != 'title'}
                                for p in graph['projects'] if p['key'] in projects), key=lambda p: p['key']),
            'nodes': sorted(({k: v for k, v in n.items() if k not in (('title', 'source') if semantic else ('title',))}
                             for n in graph['nodes'] if n['id'] in closure), key=lambda n: n['id']),
            'edges': sorted((({k: v for k, v in e.items() if k != 'source'} if semantic else e)
                             for e in graph['edges'] if (e['to'], e['to_event']) in events),
                            key=lambda e: json.dumps(e, sort_keys=True))}


def closure_nodes(nodes, events):
    found = {key for key, _ in events}
    for key in list(found):
        parent = nodes[key]['unit_of']
        while parent:
            found.add(parent)
            parent = nodes[parent]['unit_of']
    return found


def audit(repo, ref, snapshot, request, proposed=None, now=None, main_ref=None, local_index=None):
    if local_index and (ref or not main_ref or proposed is not None):
        raise ValueError('local admission requires --main-ref and excludes --ref/--reconcile')
    coverage = (COVERAGE['check_local'](repo, local_index, snapshot) if local_index
                else COVERAGE['check'](repo, ref, snapshot))
    sha = None if local_index else coverage['sha']
    main_sha = COVERAGE['git'](repo, 'rev-parse', '--verify', f'{main_ref or ref}^{{commit}}').strip()
    if snapshot.get('main_sha') != main_sha or (not local_index and sha != main_sha and snapshot.get('graph_sha') != sha):
        raise ValueError('live evidence must pin the exact freshly fetched main SHA')
    checked = utc(snapshot.get('checked_at'))
    now = now or datetime.now(timezone.utc)
    if not 0 <= (now - checked).total_seconds() <= 3600:
        raise ValueError('live evidence is stale or future-dated; refresh before this transition')
    read_source = (lambda path: COVERAGE['local_file'](repo, path)) if local_index else (
        lambda path: COVERAGE['read_blob'](repo, sha, path))
    index_text = read_source('orchestration/index.json')
    if index_text is None:
        raise ValueError('typed index required for deterministic admission; use the documented legacy audit')
    index = json.loads(index_text)
    # Schemas define compatibility; the adoption SHA remains provenance. Keep
    # the same dirty-source guard as validate-index without requiring a repin.
    GRAPH['installed_revision']()
    base = GRAPH['validate'](json.loads(read_source(index['manifest'])))
    if local_index and 'sha256:' + hashlib.sha256(read_source(index['manifest']).encode()).hexdigest() != coverage['manifest_digest']:
        raise ValueError('local graph changed during admission')
    selected = request.get('selected')
    if not isinstance(selected, list) or not selected or len(set(selected)) != len(selected):
        raise ValueError('selected must contain unique canonical issue UUIDs')
    transition = request.get('transition')
    if transition not in ('plan', 'build', 'merge'):
        raise ValueError('transition must be plan, build or merge')
    live_input = None
    live_projects, live_nodes, live_edges = [], [], []
    if request.get('live_units') or request.get('live_relations') is True:
        if proposed is not None:
            raise ValueError('live units cannot be mixed with a proposed maintenance manifest')
        live_input = {'issues': copy.deepcopy(snapshot), 'request': copy.deepcopy(request)}
        graph, snapshot, request, live_projects, live_nodes, live_edges = live_reconcile(base, snapshot, request)
    else:
        graph = copy.deepcopy(base) if proposed is None else GRAPH['validate'](proposed)
    added, origins = ([], {})
    if live_input is not None:
        added = live_nodes
    elif graph != base:
        added, origins = reconcile(base, graph, request.get('repairs', []), selected)
    elif request.get('repairs'):
        raise ValueError('repair evidence has no exact graph delta')
    nodes = {n['id']: n for n in graph['nodes']}
    # A unit and its human review node may share one issue: compare the union of their incoming edges.
    issue_edges = {}
    for edge in graph['edges']:
        if nodes[edge['to']]['issue_ref']:
            issue_edges.setdefault(nodes[edge['to']]['issue_ref'], []).append(edge)
    projects = {p['key']: p for p in graph['projects']}
    issues = {i['id']: (p, i) for p in snapshot['projects'] for i in p['issues']}
    proof_list = request.get('nodes', [])
    proofs = {p['node_id']: p for p in proof_list}
    if len(proofs) != len(proof_list):
        raise ValueError('duplicate closure evidence')
    events = request.get('events', [])
    observed = {(e['node_id'], e['event']): e for e in events}
    if len(observed) != len(events):
        raise ValueError('duplicate event evidence')
    candidates = []
    local_scopes = {}
    for iid in selected:
        matches = [n for n in nodes.values() if n['kind'] == 'unit' and n['issue_ref'] == iid]
        if len(matches) != 1:
            raise ValueError('UNMAPPED: selected work needs one verified executable unit or bounded local repair')
        node = matches[0]
        origin = origins.get(node['id'])
        roots = {(node['id'], e) for e in ('plan', 'build', 'merge')}
        published_events = ancestors(graph, roots)
        published_closure = closure_nodes(nodes, published_events)
        if origin:
            roots.update((origin, e) for e in ('plan', 'build', 'merge'))
        closure_events = ancestors(graph, roots)
        closure = closure_nodes(nodes, closure_events)
        for key in sorted(closure):
            n = nodes[key]
            p = projects[n['project']]
            if p['authorization'] != 'recorded':
                raise ValueError('REVIEWED_PUBLICATION_REQUIRED: scope authorization is draft')
            proof = proofs.get(key, {})
            scope = proof.get('scope', {})
            path = COVERAGE['safe_path'](scope.get('path'))
            text = read_source(path)
            if local_index and text is not None:
                local_scopes[path] = {'text': text, 'digest': 'sha256:' + hashlib.sha256(text.encode()).hexdigest()}
            line = scope.get('line')
            quote = required_text(scope.get('quote'), 'approved scope quote')
            if type(line) is not int or line < 1 or text is None or '\n'.join(
                    text.splitlines()[line-1:line-1+len(quote.splitlines())]) != quote:
                raise ValueError('scope citation must match exact lines on pinned graph source')
            required_text(scope.get('rationale'), 'scope applicability rationale')
            if proof.get('owner') != n['owner'] or proof.get('acceptance') != n['acceptance']:
                raise ValueError('verified ownership and exact acceptance conditions required throughout closure')
            required_text(proof.get('source'), 'ownership/acceptance source')
            incoming = [e for e in graph['edges'] if e['to'] == key]
            if proof.get('prerequisites') != incoming:
                raise ValueError('complete prerequisite evidence must match the dependency closure')
            if n['issue_ref']:
                entry = issues.get(n['issue_ref'])
                if entry is None or entry[0]['project_id'] != p['linear_id']:
                    raise ValueError('complete live issue/project membership required throughout closure')
                issue = entry[1]
                for field in ('description', 'url', 'updated_at'):
                    required_text(issue.get(field), 'live issue ' + field)
                if issue.get('relations_complete') is not True:
                    raise ValueError('complete live relations and issue-body prerequisite read required')
                if issue.get('prerequisites') != issue_edges.get(n['issue_ref'], []):
                    raise ValueError('REVIEWED_PUBLICATION_REQUIRED: live dependencies differ from reviewed graph')
                # The rendered Markdown view is presentation, not an admission
                # condition. Its drift remains visible in coverage warnings.
        # Check current phase only. Future merge/human/release gates stay visible.
        required = ancestors(graph, {(node['id'], transition)})
        if origin:
            required |= ancestors(graph, {(origin, transition)})
        required = {event for event in required if event[0] != node['id']}
        unmet = []
        for event in sorted(required):
            observation = observed.get(event, {})
            if observation.get('state') not in ('SATISFIED', 'UNSATISFIED', 'UNKNOWN'):
                raise ValueError('incomplete event prerequisite evidence')
            required_text(observation.get('source'), 'event evidence source')
            if observation['state'] != 'SATISFIED':
                unmet.append({'node_id': event[0], 'event': event[1], 'state': observation['state']})
        def evidence_digest(keys, required_events, candidate_events, semantic=False):
            def prerequisites(edges):
                selected_edges = [e for e in edges if (e['to'], e['to_event']) in candidate_events]
                return semantic_edges(selected_edges) if semantic else selected_edges
            return digest({
                'nodes': [{'node_id': key,
                           'scope': {field: proofs[key]['scope'][field] for field in ('path', 'quote')},
                           'owner': proofs[key]['owner'], 'acceptance': proofs[key]['acceptance'],
                           'prerequisites': prerequisites(proofs[key]['prerequisites'])} for key in sorted(keys)],
                'issues': [{**{field: issues[nodes[k]['issue_ref']][1][field]
                               for field in ('id', 'identifier', 'description')},
                            'description': approval_body(issues[nodes[k]['issue_ref']][1]['description']) if semantic else issues[nodes[k]['issue_ref']][1]['description'],
                            'prerequisites': prerequisites(issues[nodes[k]['issue_ref']][1]['prerequisites'])}
                           for k in sorted(keys) if nodes[k]['issue_ref']],
                'events': [{'node_id': key, 'event': event, 'state': observed[(key, event)]['state']}
                           for key, event in sorted(required_events)]})
        # Audit and retain the origin while a repair is local. Publication may
        # drop that extra closure only when both of the repair's own digests match.
        published_required = {e for e in ancestors(graph, {(node['id'], transition)}) if e[0] != node['id']}
        live_affected = live_input is not None and (any(n['id'] in closure for n in live_nodes) or
            any((e['to'], e['to_event']) in closure_events for e in live_edges))
        candidates.append({'issue_id': iid, 'identifier': issues[iid][1]['identifier'],
                           'project_id': projects[node['project']]['linear_id'],
                           'state': 'BLOCKED' if unmet else 'ELIGIBLE',
                           'mode': 'LIVE_RECONCILIATION' if live_affected else 'APPROVED_LOCAL' if local_index else 'LOCAL_RECONCILIATION' if origin else 'PUBLISHED',
                           'node_id': node['id'], 'closure': sorted(closure),
                           'closure_graph_digest': digest(closure_graph(graph, closure_events, closure)),
                           'closure_evidence_digest': evidence_digest(closure, required, closure_events),
                           'published_closure_graph_digest': digest(closure_graph(graph, published_events, published_closure)),
                           'published_closure_evidence_digest': evidence_digest(published_closure, published_required, published_events),
                           'semantic_closure_graph_digest': digest(closure_graph(graph, closure_events, closure, True)),
                           'semantic_closure_evidence_digest': evidence_digest(closure, required, closure_events, True),
                           'semantic_published_closure_graph_digest': digest(closure_graph(graph, published_events, published_closure, True)),
                           'semantic_published_closure_evidence_digest': evidence_digest(published_closure, published_required, published_events, True),
                           'unmet': unmet})
    local_pins = {}
    if local_index:
        repeated = COVERAGE['check_local'](repo, local_index, snapshot)
        fields = ('index_path', 'manifest_path', 'index_digest', 'manifest_digest', 'source_revision')
        if any(repeated[k] != coverage[k] for k in fields) or any(
                read_source(path) != source['text'] for path, source in local_scopes.items()):
            raise ValueError('local graph/scope changed during admission; repeat the audit')
        local_pins = {'local_graph': {k: coverage[k] for k in fields}}
    return {'schema_version': 1, 'main_sha': main_sha, 'graph_sha': sha, **local_pins, 'checked_at': snapshot['checked_at'],
            'transition': transition, 'coverage': coverage,
            'base_digest': digest(base), 'graph_digest': digest(graph),
            'issue_evidence_digest': digest(snapshot), 'evidence': {'issues': snapshot, 'request': request,
                **({'live_input': live_input} if live_input is not None else {}),
                **({'local_scope_sources': local_scopes} if local_index else {})},
            'delta': {'added_nodes': added, 'changed_edges': [], 'repairs': request.get('repairs', []),
                      **({'kind': 'LIVE_RECONCILIATION', 'added_projects': live_projects, 'added_edges': live_edges} if live_input is not None else {})},
            'candidates': candidates, 'state': 'ELIGIBLE' if all(c['state'] == 'ELIGIBLE' for c in candidates) else 'BLOCKED'}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', type=Path, required=True)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument('--ref')
    source.add_argument('--local-index', type=Path)
    parser.add_argument('--main-ref', help='fresh main ref when --ref is an explicitly accepted PR head')
    parser.add_argument('--issues', type=Path, required=True)
    parser.add_argument('--request', type=Path, required=True)
    parser.add_argument('--reconcile', type=Path, help='complete proposed manifest; append-only maintenance delta')
    args = parser.parse_args()
    try:
        report = audit(args.repo, args.ref, json.loads(args.issues.read_text()),
                       json.loads(args.request.read_text()),
                       json.loads(args.reconcile.read_text()) if args.reconcile else None,
                       main_ref=args.main_ref, local_index=args.local_index)
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
        state = next((s for s in ('REVIEWED_PUBLICATION_REQUIRED', 'UNMAPPED') if str(error).startswith(s + ':')), 'UNKNOWN')
        print(json.dumps({'state': state, 'error': str(error)}))
        return 1
    print(json.dumps(report, indent=2))
    return 0 if report['state'] == 'ELIGIBLE' else 1


if __name__ == '__main__':
    sys.exit(main())
