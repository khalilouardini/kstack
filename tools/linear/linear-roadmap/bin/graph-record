#!/usr/bin/env python3
"""Validate/render a declarative roadmap. Stdlib only; no network or mutations."""
import argparse
import html
import json
from pathlib import Path
import re
import sys

SCHEMA = Path(__file__).resolve().parents[1] / 'references/graph.schema.json'
EVENTS = {
    'unit': ('plan', 'build', 'merge'), 'group': (),
    'human': ('approve',), 'evidence': ('pass',),
    'external': ('complete',), 'release': ('release',),
}


def check_schema(value, schema, path='$'):
    """Evaluate the closed JSON Schema subset used by the bundled contract."""
    checks = {'object': lambda v: isinstance(v, dict),
              'array': lambda v: isinstance(v, list),
              'string': lambda v: isinstance(v, str),
              'integer': lambda v: isinstance(v, int) and not isinstance(v, bool),
              'null': lambda v: v is None}
    types = schema.get('type', [])
    types = [types] if isinstance(types, str) else types
    if types and not any(checks[t](value) for t in types):
        raise ValueError(f'{path}: expected {types}')
    if 'const' in schema and value != schema['const']:
        raise ValueError(f'{path}: expected {schema["const"]!r}')
    if 'enum' in schema and value not in schema['enum']:
        raise ValueError(f'{path}: invalid value {value!r}')
    if isinstance(value, dict):
        props = schema.get('properties', {})
        missing = set(schema.get('required', [])) - value.keys()
        unknown = value.keys() - props.keys()
        if missing or (unknown and schema.get('additionalProperties') is False):
            raise ValueError(f'{path}: missing {sorted(missing)}, unknown {sorted(unknown)}')
        for k, v in value.items():
            if k in props:
                check_schema(v, props[k], f'{path}.{k}')
    elif isinstance(value, list):
        if len(value) < schema.get('minItems', 0):
            raise ValueError(f'{path}: too few items')
        for i, v in enumerate(value):
            check_schema(v, schema.get('items', {}), f'{path}[{i}]')
    elif isinstance(value, str):
        if not value.strip() or len(value) < schema.get('minLength', 0):
            raise ValueError(f'{path}: empty string')
        if 'pattern' in schema and not re.fullmatch(schema['pattern'], value):
            raise ValueError(f'{path}: invalid identifier')
    elif isinstance(value, int) and not isinstance(value, bool):
        if value < schema.get('minimum', value) or value > schema.get('maximum', value):
            raise ValueError(f'{path}: out of bounds')


def acyclic(graph, label):
    indegree = {n: 0 for n in graph}
    for targets in graph.values():
        for n in targets:
            indegree[n] += 1
    ready = [n for n, degree in indegree.items() if degree == 0]
    visited = 0
    while ready:
        n = ready.pop()
        visited += 1
        for target in graph[n]:
            indegree[target] -= 1
            if indegree[target] == 0:
                ready.append(target)
    if visited != len(graph):
        remaining = sorted(str(n) for n, degree in indegree.items() if degree)
        raise ValueError(f'{label} cycle: {", ".join(remaining)}')


def validate(record):
    check_schema(record, json.loads(SCHEMA.read_text()))
    projects = {p['key']: p for p in record['projects']}
    if len(projects) != len(record['projects']):
        raise ValueError('duplicate project key')
    linear_ids = [p['linear_id'] for p in record['projects'] if p['linear_id'] is not None]
    if len(set(linear_ids)) != len(linear_ids):
        raise ValueError('one Linear project mapped to multiple project keys')
    nodes = {n['id']: n for n in record['nodes']}
    if len(nodes) != len(record['nodes']):
        raise ValueError('duplicate node id')
    issue_refs = set()
    containment = {n: set() for n in nodes}
    graph = {(n['id'], e): set() for n in nodes.values() for e in EVENTS[n['kind']]}
    for n in nodes.values():
        if n['project'] not in projects:
            raise ValueError(f'{n["id"]}: unknown project')
        if n['unit_of'] is not None:
            parent = nodes.get(n['unit_of'])
            if not parent or parent['kind'] != 'group' or parent['project'] != n['project']:
                raise ValueError(f'{n["id"]}: unit_of must name a group in the same project')
            containment[parent['id']].add(n['id'])
        if n['kind'] == 'unit':
            project = projects[n['project']]
            if n['issue_ref'] is None and project['authorization'] == 'recorded':
                raise ValueError(f'{n["id"]}: recorded project has a unit without a real issue_ref')
            if project['authorization'] == 'recorded' and project['linear_id'] is None:
                raise ValueError(f'{n["id"]}: recorded project lacks linear_id')
            if n['issue_ref'] is not None:
                if n['issue_ref'] in issue_refs:
                    raise ValueError('one issue_ref mapped to multiple executable units')
                issue_refs.add(n['issue_ref'])
            graph[(n['id'], 'plan')].add((n['id'], 'build'))
            graph[(n['id'], 'build')].add((n['id'], 'merge'))
    acyclic(containment, 'containment')
    seen = set()
    for e in record['edges']:
        a, b = nodes.get(e['from']), nodes.get(e['to'])
        if a is None or b is None:
            raise ValueError('edge references an unknown node')
        source, target = (e['from'], e['from_event']), (e['to'], e['to_event'])
        if source not in graph or target not in graph:
            raise ValueError('edge references an unsupported event or a non-executable group')
        if source == target:
            raise ValueError('self dependency')
        kind = e['type']
        if kind == 'start_after' and (b['kind'] != 'unit' or e['to_event'] not in ('plan', 'build')):
            raise ValueError('start_after must target unit plan/build')
        if kind == 'merge_after' and (b['kind'] != 'unit' or e['to_event'] != 'merge'):
            raise ValueError('merge_after must target unit merge')
        if kind == 'release_after' and b['kind'] != 'release':
            raise ValueError('release_after must target release')
        if kind == 'verify_after' and b['kind'] != 'evidence':
            raise ValueError('verify_after must target evidence pass')
        if kind == 'review_after' and b['kind'] != 'human':
            raise ValueError('review_after must target human approve')
        if kind == 'evidence_required' and a['kind'] != 'evidence':
            raise ValueError('evidence_required must come from evidence pass')
        if kind == 'human_decision' and a['kind'] != 'human':
            raise ValueError('human_decision must come from human approve')
        signature = (source, target, kind)
        if signature in seen:
            raise ValueError('duplicate dependency')
        seen.add(signature)
        graph[source].add(target)
    acyclic(graph, 'event dependency')
    return record


def render(record):
    lines = ['flowchart LR']
    nodes = record['nodes']

    def label(title):
        return html.escape(' '.join(title.split()), quote=True)

    def children(project, parent, indent):
        for n in nodes:
            if n['project'] != project or n['unit_of'] != parent:
                continue
            title = label(n['title'])
            if n['kind'] == 'group':
                lines.append(f'{indent}subgraph group_{n["id"]}["{title}"]')
                children(project, n['id'], indent + '  ')
                lines.append(indent + 'end')
            elif n['kind'] == 'human':
                lines.append(f'{indent}node_{n["id"]}{{"HUMAN: {title}"}}')
            else:
                lines.append(f'{indent}node_{n["id"]}["{title}"]')

    for project in record['projects']:
        lines.append(f'  subgraph project_{project["key"]}["{label(project["title"])}"]')
        children(project['key'], None, '    ')
        lines.append('  end')
    for edge in record['edges']:
        title = f'{edge["type"]}: {edge["from_event"]} to {edge["to_event"]}'
        arrow = '-->' if edge['type'] == 'start_after' else '-.->'
        lines.append(f'  node_{edge["from"]} {arrow}|"{title}"| node_{edge["to"]}')
    return '\n'.join(lines) + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('validate', 'render'))
    parser.add_argument('manifest', type=Path)
    args = parser.parse_args()
    try:
        record = validate(json.loads(args.manifest.read_text()))
    except (OSError, ValueError, TypeError) as error:
        print(f'INVALID: {error}', file=sys.stderr)
        return 1
    if args.action == 'render':
        print(render(record), end='')
    else:
        print(f'VALID structure: {len(record["projects"])} project(s), {len(record["nodes"])} nodes. Live readiness not checked.')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
