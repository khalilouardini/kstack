#!/usr/bin/env python3
"""Read-only kstack installation audit. No fetch, writes or reinstall actions."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys


POINTER = 'kstack pointer'
SOURCE = re.compile(r'^Read `(.+/SKILL\.md)` with your file-reading tool', re.MULTILINE)


def git(root: Path, *args: str) -> str:
    result = subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True,
                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})
    if result.returncode:
        raise ValueError(result.stderr.strip() or 'git command failed: ' + ' '.join(args))
    return result.stdout.rstrip('\n')


def metadata(path: Path) -> dict[str, str]:
    text = path.read_text(encoding='utf-8')
    if not text.startswith('---\n') or '\n---' not in text[4:]:
        raise ValueError(f'invalid frontmatter: {path}')
    block = text.split('---', 2)[1]
    return {match[1]: match[2] for line in block.splitlines()
            if (match := re.fullmatch(r'(name|version|description):\s*(.+)', line))}


def skills(root: Path) -> dict[str, Path]:
    found = {}
    tiers = [root / tier for tier in ['router', 'core', 'roles']]
    tiers.extend(path for path in (root / 'tools').glob('*') if path.is_dir())
    for tier in tiers:
        for path in sorted([*tier.glob('*/SKILL.md'), *tier.glob('*/*/SKILL.md')]):
            name = path.parent.name
            if name in found:
                raise ValueError(f'duplicate canonical skill: {name}')
            meta = metadata(path)
            if meta.get('name') != name or not all(meta.get(k) for k in ['name', 'version', 'description']):
                raise ValueError(f'incomplete/mismatched canonical frontmatter: {path}')
            found[name] = path.resolve()
    if not found or not (root / 'bin/install').is_file() or not (root / 'CONVENTIONS.md').is_file():
        raise ValueError(f'not a canonical kstack checkout: {root}')
    return found


def pointer_issue(path: Path, canonical: Path) -> str | None:
    if path.is_symlink() or path.parent.is_symlink():
        return 'installer refuses symlinked Codex destinations'
    if not path.is_file():
        return 'missing SKILL.md'
    text = path.read_text(encoding='utf-8')
    if POINTER not in text:
        return 'existing file is not a generated kstack pointer'
    source = SOURCE.search(text)
    if not source or not Path(source[1]).is_absolute() or Path(source[1]).resolve() != canonical:
        return 'points to another/missing canonical source'
    if metadata(path) != metadata(canonical):
        return 'stale name/version/description'
    return None


def host_status(expected: dict[str, Path], root: Path, home: Path, codex_home: Path) -> dict:
    hosts = {}
    for host, base in [('claude', home / '.claude/skills'), ('codex', codex_home / 'skills')]:
        issues, current = [], 0
        for name, canonical in expected.items():
            entry = base / name
            try:
                if host == 'claude':
                    issue = None if (entry.is_symlink() and entry.resolve() == canonical.parent
                                     and (entry / 'SKILL.md').is_file()) else 'missing, copied or wrong symlink target'
                else:
                    issue = pointer_issue(entry / 'SKILL.md', canonical)
                if issue:
                    issues.append({'skill': name, 'path': str(entry), 'reason': issue,
                                   'target': os.readlink(entry) if entry.is_symlink() else None})
                else:
                    current += 1
            except (OSError, ValueError, RuntimeError) as error:
                issues.append({'skill': name, 'path': str(entry), 'reason': str(error)})
        if base.is_dir():
            for entry in sorted(base.iterdir()):
                if entry.name in expected:
                    continue
                try:
                    if host == 'codex':
                        file = entry / 'SKILL.md'
                        owned = file.is_file() and POINTER in file.read_text(encoding='utf-8')
                    else:
                        owned = entry.is_symlink() and entry.resolve().is_relative_to(root)
                    if owned:
                        issues.append({'skill': entry.name, 'path': str(entry), 'reason': 'orphaned kstack adapter'})
                except (OSError, ValueError, RuntimeError) as error:
                    issues.append({'path': str(entry), 'reason': str(error)})
        hosts[host] = {'directory': str(base), 'expected': len(expected), 'current': current,
                       'issues': issues}
    return hosts


def project_roots(root: Path, projects: list[Path], projects_under: list[Path]) -> tuple[list[Path], list[str], list[str]]:
    """Bounded sibling discovery plus registered worktrees; never recurse data dirs."""
    candidates, errors, prunable = {root.resolve()}, [], []
    for path in projects:
        if path.is_dir():
            candidates.add(path.resolve())
        else:
            errors.append(f'project unavailable: {path}')
    for parent in projects_under:
        try:
            for child in parent.iterdir():
                if child.is_dir() and ((child / '.git').exists() or any(
                        (child / folder).is_dir() for folder in ['.claude/skills', '.agents/skills', '.codex/skills'])):
                    candidates.add(child.resolve())
        except OSError as error:
            errors.append(f'{parent}: {error}')
    seen_common = set()
    for candidate in sorted(candidates):
        if not (candidate / '.git').exists():
            continue
        try:
            common = git(candidate, 'rev-parse', '--path-format=absolute', '--git-common-dir')
            if common in seen_common:
                continue
            seen_common.add(common)
            for record in git(candidate, 'worktree', 'list', '--porcelain', '-z').split('\0\0'):
                fields = record.split('\0')
                location = next((item[len('worktree '):] for item in fields if item.startswith('worktree ')), None)
                if location is None:
                    continue
                path = Path(location)
                if path.is_dir():
                    candidates.add(path.resolve())
                elif any(item == 'prunable' or item.startswith('prunable ') for item in fields):
                    prunable.append(str(path))
                else:
                    errors.append(f'registered worktree unavailable: {path}')
        except ValueError as error:
            errors.append(f'{candidate}: {error}')
    return sorted(candidates), errors, sorted(prunable)


def project_status(expected: dict[str, Path], roots: list[Path]) -> tuple[list[dict], list[str]]:
    overrides, errors = [], []
    for root in roots:
        for directory in ['.claude/skills', '.agents/skills', '.codex/skills']:
            for name, canonical in expected.items():
                entry = root / directory / name
                try:
                    if not entry.exists() and not entry.is_symlink():
                        continue
                    if entry.is_symlink() and entry.resolve(strict=True) == canonical.parent:
                        continue  # a live project link to this canonical source
                    file = entry / 'SKILL.md'
                    if file.is_file() and pointer_issue(file, canonical) is None:
                        continue  # matching generated adapter, not a copied procedure
                    overrides.append({'project': str(root), 'skill': name, 'path': str(entry),
                                      'kind': 'local copy or distinct adapter' if not entry.is_symlink() else 'different/broken link',
                                      'target': str(entry.resolve()) if entry.is_symlink() else None})
                except (OSError, ValueError, RuntimeError) as error:
                    errors.append(f'{entry}: {error}')
    return overrides, errors


def audit(root: Path, home: Path, codex_home: Path, state: Path,
          projects: list[Path], projects_under: list[Path]) -> dict:
    root = root.resolve(strict=True)
    expected = skills(root)
    if Path(git(root, 'rev-parse', '--show-toplevel')).resolve() != root:
        raise ValueError('root must name the checkout root')
    branch = git(root, 'branch', '--show-current')
    dirty = git(root, 'status', '--porcelain=v1', '--untracked-files=all')
    try:
        tracking = git(root, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD')
        tracking_sha = git(root, 'rev-parse', tracking)
    except ValueError:
        tracking, tracking_sha = None, None
    head = git(root, 'rev-parse', 'HEAD')
    operations = [name for name in ['MERGE_HEAD', 'rebase-merge', 'rebase-apply', 'CHERRY_PICK_HEAD']
                  if Path(git(root, 'rev-parse', '--path-format=absolute', '--git-path', name)).exists()]
    recorded = (state / 'stack-root').read_text().strip() if (state / 'stack-root').is_file() else None
    roots, errors, prunable = project_roots(root, projects, projects_under)
    overrides, scan_errors = project_status(expected, roots)
    errors.extend(scan_errors)
    hosts = host_status(expected, root, home, codex_home)
    shared_current = (tracking is not None and branch == tracking.removeprefix('origin/')
                      and not dirty and not operations and head == tracking_sha and recorded is not None
                      and Path(recorded).is_absolute() and Path(recorded).resolve() == root
                      and all(not info['issues'] for info in hosts.values()))
    return {'shared_status': 'CURRENT' if shared_current else 'NEEDS_ATTENTION',
            'source': {'root': str(root), 'branch': branch or 'DETACHED', 'head': head,
                       'dirty': dirty.splitlines(), 'operations': operations, 'local_default_ref': tracking,
                       'local_default_sha': tracking_sha, 'recorded_root': recorded,
                       'freshness': 'local remote-tracking evidence only; this helper does not fetch'},
            'hosts': hosts,
            'projects': {'scope': {'explicit': list(map(str, projects)), 'parents': list(map(str, projects_under)),
                                   'registered_worktrees': True},
                         'checked': list(map(str, roots)), 'overrides': overrides, 'errors': errors,
                         'prunable_worktrees': prunable},
            'complete_machine_audit': False}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, help='canonical checkout; defaults to the recorded stack-root')
    parser.add_argument('--project', type=Path, action='append', default=[])
    parser.add_argument('--projects-under', type=Path, action='append', default=[],
                        help='scan immediate sibling repos here; repeatable, plus their registered worktrees')
    args = parser.parse_args()
    home = Path.home()
    state = Path(os.environ.get('KSTACK_STATE') or home / '.kstack')
    try:
        record = state / 'stack-root'
        if args.root is None and (not record.is_file() or not record.read_text().strip()):
            raise ValueError(f'missing canonical root: {record}; supply --root explicitly')
        root = args.root or Path(record.read_text().strip())
        result = audit(root.expanduser(), home, Path(os.environ.get('CODEX_HOME') or home / '.codex'),
                       state, args.project, args.projects_under)
        print(json.dumps(result, indent=2))
        return 0 if (result['shared_status'] == 'CURRENT' and not result['projects']['overrides']
                     and not result['projects']['errors']) else 1
    except (OSError, ValueError, RuntimeError) as error:
        print(json.dumps({'status': 'UNKNOWN', 'error': str(error)}, indent=2))
        return 2


if __name__ == '__main__':
    sys.exit(main())
