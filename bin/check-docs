#!/usr/bin/env python3
"""Check overview catalog parity and owned documentation's local links.

Stdlib only. Does not fetch external URLs or validate command semantics.
Markdown links/images outside fenced blocks and HTML href/src attributes are
checked, including fragments into Markdown headings and HTML IDs. Vendored
documents are excluded; their catalog entries are still required.
"""

from __future__ import annotations

from collections import Counter
from html import unescape
from html.parser import HTMLParser
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import unquote, urlsplit

REPO = Path(__file__).resolve().parent.parent
TIERS = ("router", "core", "roles", "tools")
LINK = re.compile(r"!?\[[^\]\n]*\]\(\s*(<[^>]+>|[^\s)]+)(?:\s+[^)]*)?\)")
FENCE = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
CARD = re.compile(r'\{\s*n:\s*"([^"]+)",\s*href:\s*"([^"]+)"')


def prose_lines(text: str) -> list[tuple[int, str]]:
    result = []
    fence = ""
    for number, line in enumerate(text.splitlines(), 1):
        match = FENCE.match(line)
        if match:
            marker = match[1]
            if not fence:
                fence = marker
                continue
            if marker[0] == fence[0] and len(marker) >= len(fence) and not line[match.end():].strip():
                fence = ""
                continue
        if not fence:
            result.append((number, line))
    return result


class HTMLLinks(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.links: list[tuple[int, str]] = []
        self.ids: set[str] = set()

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        for key, value in attrs:
            if value is None:
                continue
            if key in ("href", "src"):
                self.links.append((self.getpos()[0], value))
            if key == "id" or (tag == "a" and key == "name"):
                self.ids.add(value)


def anchors(path: Path) -> set[str]:
    text = path.read_text(encoding="utf-8")
    parser = HTMLLinks()
    if path.suffix == ".md":
        text = "\n".join(line for _, line in prose_lines(text))
    parser.feed(text)
    result = set(parser.ids)
    used: set[str] = set()
    if path.suffix == ".md":
        for line in text.splitlines():
            match = re.match(r"^ {0,3}#{1,6}\s+(.+?)(?:\s+#+)?\s*$", line)
            if not match:
                continue
            heading = re.sub(r"<[^>]+>", "", unescape(match[1])).lower()
            slug = re.sub(r"[^\w\- ]", "", heading).replace(" ", "-")
            candidate, suffix = slug, 0
            while candidate in used:
                suffix += 1
                candidate = f"{slug}-{suffix}"
            used.add(candidate)
            result.add(candidate)
    return result


def local_link_error(source: Path, target: str) -> str | None:
    if "${" in target:  # JS card links are checked against canonical paths below.
        return None
    url = urlsplit(unescape(target))
    if url.scheme or url.netloc:
        return None
    path = (source.parent / unquote(url.path)).resolve() if url.path else source
    if not path.exists():
        return f"missing target {target!r}"
    if url.fragment and path.is_file() and path.suffix in (".md", ".html"):
        if unquote(url.fragment) not in anchors(path):
            return f"missing anchor {target!r}"
    return None


def check_links(paths: list[Path], root: Path) -> list[str]:
    failures = []
    for path in paths:
        text = path.read_text(encoding="utf-8")
        if path.suffix == ".md":
            lines = prose_lines(text)
            links = [(n, m[1].strip("<>")) for n, line in lines for m in LINK.finditer(line)]
            # Keep line numbers when parsing inline HTML outside Markdown fences.
            parser = HTMLLinks()
            by_number = dict(lines)
            parser.feed("\n".join(by_number.get(n, "") for n in range(1, len(text.splitlines()) + 1)))
        else:
            parser = HTMLLinks()
            parser.feed(text)
            links = []
        links.extend(parser.links)
        for number, target in links:
            error = local_link_error(path, target)
            if error:
                failures.append(f"{path.relative_to(root)}:{number}: {error}")
    return failures


def catalog(root: Path) -> dict[str, Path]:
    result = {}
    for tier in TIERS:
        for path in sorted((root / tier).rglob("SKILL.md")):
            result["/" + path.parent.name] = path.resolve()
    for path in sorted((root / "roles").glob("*.md")):
        result[path.stem] = path.resolve()
    return result


def check_catalog(root: Path) -> list[str]:
    expected = catalog(root)
    failures = []
    for name in ("README.md", "docs/skill-map.md"):
        path = root / name
        links = { (path.parent / m[1].strip("<>").split("#")[0]).resolve()
                  for _, line in prose_lines(path.read_text()) for m in LINK.finditer(line)
                  if not urlsplit(m[1].strip("<>")).scheme }
        for label, target in expected.items():
            if target not in links:
                failures.append(f"{name}: catalog missing {label}")
    path = root / "docs/skill-map.html"
    text = path.read_text()
    block = re.search(r"const SKILLS = \[(.*?)\n\];", text, re.S)
    cards = CARD.findall(block[1]) if block else []
    counts = Counter(label for label, _ in cards)
    for label in sorted(expected.keys() - counts.keys()):
        failures.append(f"docs/skill-map.html: catalog missing {label}")
    for label, href in cards:
        if label not in expected:
            failures.append(f"docs/skill-map.html: unknown catalog entry {label}")
        elif (path.parent / href).resolve() != expected[label]:
            failures.append(f"docs/skill-map.html: wrong canonical link for {label}")
    for label, count in counts.items():
        if count != 1:
            failures.append(f"docs/skill-map.html: duplicate entry {label}")
    version = (root / "VERSION").read_text().strip()
    if f"kstack · v{version} ·" not in text:
        failures.append("docs/skill-map.html: header version disagrees with VERSION")
    return failures


def main() -> int:
    listing = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "*.md", "*.html"],
        cwd=REPO,
    ).decode()
    paths = sorted({REPO / p for p in listing.split("\0") if p and not p.startswith("tools/external/")})
    failures = check_links(paths, REPO) + check_catalog(REPO)
    for failure in failures:
        print(f"FAIL  {failure}")
    entries = catalog(REPO)
    skills = sum(name.startswith("/") for name in entries)
    print(f"docs: {len(paths)} owned documents, {skills} skills, {len(entries) - skills} roles; {len(failures)} failure(s)")
    return int(bool(failures))


if __name__ == "__main__":
    sys.exit(main())
